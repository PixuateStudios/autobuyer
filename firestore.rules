rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMe(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create: if isMe(userId);
      allow read: if signedIn();
      allow update, delete: if isMe(userId);
    }

    match /buyers/{buyerId} {
      allow read: if signedIn();
      allow create, update: if isMe(buyerId);
      allow delete: if false;
    }

    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.sellerId == request.auth.uid;
    }

    match /requests/{requestId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn();
    }

    match /sellers/{sellerId} {
      allow read: if signedIn();
      allow update, delete: if signedIn();
    }

    match /sellers/{sellerId}/ledgers {
      allow read: if signedIn();
      allow update, delete: if signedIn();
    }

    match /sellers/{sellerId}/ledgers/{weekStart} {
      allow read: if signedIn();
      allow update, delete: if signedIn();
    }

    match /conversations/{conversationId} {
      allow get: if signedIn() && (
        resource == null || resource.data.users.hasAny([request.auth.uid])
      );
      allow list: if signedIn() && resource.data.users.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.users.hasAny([request.auth.uid])
        && request.resource.data.users.size() == 2;
      allow update: if signedIn() && resource.data.users.hasAny([request.auth.uid]);
      allow delete: if false;

      match /messages/{messageId} {
        allow get: if signedIn() && (
          resource.data.users.hasAny([request.auth.uid])
          || get(/databases/$(database)/documents/conversations/$(conversationId)).data.users.hasAny([request.auth.uid])
        );
        allow list: if signedIn() && resource.data.users.hasAny([request.auth.uid]);
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.users.hasAny([request.auth.uid])
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.users.hasAny([request.auth.uid]);
        allow update, delete: if false;
      }
    }

    match /calls/{callId} {
      allow get: if signedIn() && (
        resource == null || request.auth.uid in resource.data.users
      );
      allow list: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.users
        && request.auth.uid == request.resource.data.callerId;
      allow update: if signedIn() && request.auth.uid in resource.data.users;
      allow delete: if false;

      match /ice/{iceId} {
        allow get, list: if signedIn() && request.auth.uid in resource.data.users;
        allow create: if signedIn()
          && request.auth.uid in request.resource.data.users
          && request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
